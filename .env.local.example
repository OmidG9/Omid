# SMTP Configuration (required for contact form emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# MySQL (primary storage). When set, all analytics/contact/security data is
# persisted here. The database must already exist:
#   CREATE DATABASE omid_portfolio CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Apply migrations with: npm run db:migrate
# DATABASE_URL=mysql://user:pass@host:3306/omid_portfolio
# MYSQL_CONNECTION_LIMIT=3

# Upstash Redis (optional - used for rate limiting + settings cache, NOT domain
# data anymore; falls back to in-memory if absent)
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# ── Admin dashboard auth ──────────────────────────────────────────────────────
# ADMIN_SECRET signs the admin session cookie. Required in production; without
# it the dashboard redirects to /admin/login and login returns a 500.
# In development a non-secret fallback is used automatically.
ADMIN_SECRET=replace-with-a-long-random-string

# Admin login credentials are stored in the `admin_user` table (migration
# 0004_admin_user.sql), NOT in env vars. Create/reset the admin user with:
#   npm run db:migrate
#   npm run admin:create
# Optionally set your own username/password for that command:
#   ADMIN_USERNAME=my-name ADMIN_PASSWORD='a-very-strong-password' npm run admin:create