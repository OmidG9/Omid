# SMTP Configuration (required for contact form emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Admin auth (REQUIRED for the /admin dashboard — there is no dev fallback
# unless you explicitly opt in with ALLOW_DEV_AUTH=1 in development).
# Generate strong values, e.g.:
#   openssl rand -hex 32        # ADMIN_SECRET
#   openssl rand -base64 18     # ADMIN_PASSWORD
ADMIN_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me-to-a-strong-password
# ALLOW_DEV_AUTH=1              # dev-only: enables the local fallback (never in production)

# Public site URL (single source of truth for canonical/OG/sitemap/robots)
SITE_URL=https://ghanbariomid.ir
# TRUST_PROXY=1                 # set when behind your own reverse proxy (nginx):
#                               # then x-forwarded-for is trusted for client IPs

# MySQL (primary storage). When set, all analytics/contact/security data and
# admin settings are persisted here. The database must already exist:
#   CREATE DATABASE omid_portfolio CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Apply migrations with: npm run db:migrate
# Prune old analytics with: npm run db:retention  (or DRY_RUN=1 to preview)
DATABASE_URL=mysql://user:pass@host:3306/omid_portfolio
MYSQL_CONNECTION_LIMIT=3

# Upstash Redis (optional - legacy backend + rate limiting when MySQL is absent;
# falls back to in-memory if absent)
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...